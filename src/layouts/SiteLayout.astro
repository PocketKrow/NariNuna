---
import SiteHeader from "@/components/layout/SiteHeader.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import pages from "@/data/projectPages.json";
import identity from "@/data/creator-identity.json";
import "@/styles/main.scss";
interface Props { pageId: string }
const page = pages.find(({ id }) => id === Astro.props.pageId);
if (!page) throw new Error(`Unregistered Nari page: ${Astro.props.pageId}`);
---
<!doctype html>
<html lang="en" data-theme="nari">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fbf3e5" />
    <meta name="description" content={page.description} />
    <title>{page.title}</title>
    {page.socialImage ? <Fragment>
      <meta property="og:type" content="website" />
      <meta property="og:title" content={page.title} />
      <meta property="og:description" content={page.socialDescription} />
      <meta property="og:image" content={page.socialImage} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content={page.socialImage} />
    </Fragment> : <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href={identity.faviconSrc} />
  </head>
  <body data-route={page.routeName}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader currentPath={page.path} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <SiteFooter currentPath={page.path} />
  </body>
</html>
