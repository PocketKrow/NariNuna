---
import PlatformIcon from "@/components/ui/PlatformIcon.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import CreatorArt from "@/components/art/CreatorArt.astro";
import MomentPreviews from "@/components/ui/MomentPreviews.astro";
import SocialDock from "@/components/ui/SocialDock.vue";
import { nariLinks, twitchUrl, discordUrl, throneUrl } from "@/data/socials";
import { ArrowRight, ArrowUpRight } from "@lucide/vue";
const youtube = nariLinks.find(({ platform }) => platform === "youtube")!;
---
<SiteLayout pageId="links">
  <section class="page-opening illustrated-opening page-width"><div><p class="eyebrow">Streams, updates & good company</p><h1>Good company.<br /><em>Real connections.</em></h1><p>Come for the game. Stay for the yap, the Ghosties, and the glorious panic.</p></div><CreatorArt asset="ghostie-play" class="opening-art" sizes="(min-width: 48rem) 200px, 100px" eager /></section>
  <section class="platform-spread page-width" aria-labelledby="watch-title">
    <div class="live-platform"><p class="eyebrow">The streams</p><h2 id="watch-title">Pull up a seat.</h2><p>Games, tangents, and plans that lasted about three seconds.</p><a class="button" href={twitchUrl} target="_blank" rel="noopener noreferrer"><PlatformIcon platform="twitch" /> Watch on Twitch <ArrowUpRight size={17} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a></div>
    <div class="video-platform"><p class="eyebrow">Between streams</p><h2>The good bits stay.</h2><p>Videos, Shorts, nail content, and highlights.</p><a class="text-link" href={youtube.url} target="_blank" rel="noopener noreferrer"><PlatformIcon platform="youtube" /> Nari on YouTube <ArrowUpRight size={16} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a></div>
  </section>
  <section class="elsewhere page-width" aria-labelledby="elsewhere-title"><h2 id="elsewhere-title">A little Nari, elsewhere.</h2><SocialDock /><p class="small-note">Support is optional. Your presence already counts.</p></section>
  <section id="moments" class="moments page-width" aria-labelledby="moments-title"><div class="section-heading"><div><p class="eyebrow">A few favorite moments</p><h2 id="moments-title">Very <em>Nari.</em></h2></div><p class="small-note">A little preview. The full moment opens on YouTube.</p></div><MomentPreviews /></section>
  <section id="community" class="community-note haven-community page-width" aria-labelledby="community-title"><CreatorArt asset="ghostie-bloom" sizes="(min-width: 48rem) 160px, 100px" /><div><p class="eyebrow">The Haven · Nari & the Ghosties</p><h2 id="community-title">Come as you are.<br /><em>Make yourself at home.</em></h2><p>Loud laughs, quiet corners, and room for your whole weird self. Kindness has a backbone here: respect, care, and boundaries belong together.</p><details class="haven-peek"><summary>What's it like inside? <span aria-hidden="true">+</span></summary><div><p>Good company, shared games, creative curiosity, and people who need a little time to warm up. You can join the conversation or take your time.</p><a href="/meet-nari/#community">Get to know the community values</a></div></details><a class="button" href={discordUrl} target="_blank" rel="noopener noreferrer">Come hang out on Discord <ArrowUpRight size={16} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a><p class="small-note">Always optional. If the invite stops working, check Nari's public profiles for an updated link.</p></div></section>
  <section id="support" class="support-note page-width" aria-labelledby="support-title"><p class="eyebrow">Always optional</p><h2 id="support-title">Just being here <em>counts.</em></h2><p>Watch, share a good moment, or bring a little kindness to chat. There's a wishlist, too, if you'd like to give something.</p><a class="text-link" href={throneUrl} target="_blank" rel="noopener noreferrer">Nari's Throne wishlist <ArrowRight size={16} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a><p class="small-note">Financial support never buys access, ownership, or a claim on Nari's time.</p></section>
</SiteLayout>
