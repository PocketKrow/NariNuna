---
import SiteLayout from "@/layouts/SiteLayout.astro";
import NariModel from "@/components/art/NariModel.astro";
import ArtImage from "@/components/art/ArtImage.astro";
import { communityGhostieArtwork } from "@/data/artwork";
import { identityPillars, communityValues } from "@/data/content";
import { ArrowRight } from "@lucide/vue";
---
<SiteLayout pageId="meetNari">
  <section class="meet-opening page-width">
    <div class="meet-copy"><p class="eyebrow">The warmth, the chaos, and the craft</p><h1>Hi, I'm <em>Nari.</em></h1><p class="intro-line">VTuber. Gamer. Nail-polish menace.<br />Your loud big sister.</p><p>Nari is a warm, protective, curious VTuber, gamer, self-taught nail artist, and prolific yapper.</p><p>The jokes can be loud. The welcome is warm. Nobody has to earn basic respect, and kindness is never permission to cross a boundary.</p><a class="text-link" href="/links/">Come hang around <ArrowRight size={16} aria-hidden="true" /></a></div>
    <figure class="portrait-note"><NariModel class="meet-model" /><figcaption>Warm welcome. Sharp boundaries.</figcaption><a class="art-credit" href="/credits/#nari-character-attribution-pending">Artwork credits</a></figure>
  </section>
  <section class="identity-notes page-width" aria-label="A few things about Nari">
    {identityPillars.map(({ eyebrow, title, text }) => <article><p class="eyebrow">{eyebrow}</p><h2>{title}</h2><p>{text}</p></article>)}
  </section>
  <section id="community" class="values-note page-width" aria-labelledby="values-title">
    <div class="values-intro"><ArtImage artwork={communityGhostieArtwork.heart} sizes="160px" maxWidth={256} /><p class="eyebrow">The Haven, in a few words</p><h2 id="values-title">Kindness<br /><em>has a backbone.</em></h2><p>Loud laughs. Quiet corners.<br />Room to be yourself.</p></div>
    <ol class="values-list">{communityValues.map(({ title, description }) => <li><h3>{title}</h3><p>{description}</p></li>)}</ol>
  </section>
</SiteLayout>
