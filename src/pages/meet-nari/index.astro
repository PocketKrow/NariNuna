---
import SiteLayout from "@/layouts/SiteLayout.astro";
import CreatorArt from "@/components/art/CreatorArt.astro";
import { identityPillars, communityValues } from "@/data/content";
import { ArrowRight } from "@lucide/vue";
---
<SiteLayout pageId="meetNari">
  <section class="meet-opening meet-banner page-width" aria-labelledby="meet-title">
    <div class="meet-copy"><p class="eyebrow">Hey. Come on in.</p><h1 id="meet-title">I'm <em>Nari Nuna.</em><br />Welcome to the Haven.</h1><p class="intro-line">VTuber. Gamer. Nail-polish menace.<br />Your loud big sister.</p><p>A little chaos, a lot of curiosity, and room to be yourself. Come for the games, stay for the yap—or just find a quiet corner.</p><p>The jokes can be loud. The welcome is warm. Nobody has to earn basic respect, and kindness is never permission to cross a boundary.</p><a class="text-link" href="/links/#community">Make yourself at home <ArrowRight size={16} aria-hidden="true" /></a></div>
    <figure class="meet-banner-art"><CreatorArt asset="haven-banner" sizes="(min-width: 64rem) 520px, (min-width: 48rem) 380px, 90vw" eager priority /><figcaption>Warm welcome. Sharp boundaries.</figcaption><a class="art-credit" href="/credits/#website-storybook-artwork">Artwork credits</a></figure>
  </section>
  <section class="identity-notes page-width" aria-label="A few things about Nari">
    {identityPillars.map(({ eyebrow, title, text }) => <article><p class="eyebrow">{eyebrow}</p><h2>{title}</h2><p>{text}</p></article>)}
  </section>
  <section id="community" class="values-note page-width" aria-labelledby="values-title">
    <div class="values-intro"><CreatorArt asset="ghostie-bloom" sizes="160px" /><p class="eyebrow">The Haven, in a few words</p><h2 id="values-title">Kindness<br /><em>has a backbone.</em></h2><p>Loud laughs. Quiet corners.<br />Room to be yourself.</p></div>
    <ol class="values-list">{communityValues.map(({ title, description }) => <li><h3>{title}</h3><p>{description}</p></li>)}</ol>
  </section>
</SiteLayout>
