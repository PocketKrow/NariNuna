---
import SiteLayout from "@/layouts/SiteLayout.astro";
import SceneFigure from "@/components/art/SceneFigure.astro";
import { identityPillars } from "@/data/content";
import { ArrowRight } from "@lucide/vue";
---
<SiteLayout pageId="meetNari">
  <section class="meet-opening page-width" aria-labelledby="meet-title">
    <div class="meet-copy"><p class="eyebrow handwritten">A little introduction</p><h1 id="meet-title">Hi, I'm <em>Nari.</em></h1>
      <p class="intro-line">VTuber. Gamer. Nail-polish menace.</p>
      <p>A little chaos, a lot of curiosity, and room to be yourself. Come for the games, stay for the yap—or find a quiet corner.</p>
      <p>Warm, protective big-sister energy. Occasionally very loud.</p>
    </div>
    <SceneFigure scene="meetNari" eager priority />
  </section>
  <section class="identity-notes page-width" aria-label="A few things about Nari">
    {identityPillars.map(({ title, text }) => <article><h2>{title}</h2><p>{text}</p></article>)}
  </section>
  <section id="community" class="personal-note page-width" aria-labelledby="kindness-title">
    <div><p class="eyebrow">The welcome has a spine</p><h2 id="kindness-title">Kindness<br /><em>has a backbone.</em></h2></div>
    <div><p>Nobody has to earn basic respect. Being kind doesn't mean giving up your boundaries, and belonging doesn't mean anyone owns your time.</p><a class="text-link" href="/haven/">Get to know the Haven <ArrowRight size={16} aria-hidden="true" /></a></div>
  </section>
</SiteLayout>
