---
import SiteLayout from "@/layouts/SiteLayout.astro";
import SceneFigure from "@/components/art/SceneFigure.astro";
import PlatformIcon from "@/components/ui/PlatformIcon.astro";
import MomentPreviews from "@/components/ui/MomentPreviews.astro";
import { twitchUrl, nariLinks } from "@/data/socials";
import { ArrowUpRight } from "@lucide/vue";
const youtube = nariLinks.find(({ platform }) => platform === "youtube")!;
// Streams owns the existing Shorts collection; no player, status feed or invented schedule.
---
<SiteLayout pageId="streams">
  <section class="connections-opening page-opening page-width" aria-labelledby="streams-title">
    <div><p class="eyebrow handwritten">There's room in chat</p><h1 id="streams-title">Come for the game.<br /><em>Stay for the yap.</em></h1>
      <p class="intro-line">Good company. Glorious panic.</p><p>Games, tangents, and plans that lasted about three seconds. The game is only part of the fun.</p>
      <a class="button" href={twitchUrl} target="_blank" rel="noopener noreferrer"><PlatformIcon platform="twitch" /> Watch on Twitch <ArrowUpRight size={17} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a>
    </div><SceneFigure scene="streams" eager priority />
  </section>
  <section id="moments" class="moments page-width" aria-labelledby="moments-title">
    <div class="section-heading"><div><p class="eyebrow">Favorite moments</p><h2 id="moments-title">Oh, that's <em>Nari.</em></h2></div><a class="text-link" href={youtube.url} target="_blank" rel="noopener noreferrer">More on YouTube <ArrowUpRight size={16} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a></div>
    <MomentPreviews />
  </section>
</SiteLayout>
