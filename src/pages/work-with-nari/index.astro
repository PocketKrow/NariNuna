---
import RoomCompanion from "@/components/astro/RoomCompanion.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import RoomArrival from "@/components/astro/RoomArrival.astro";

// Own the correspondence letter and native public-profile directory. Keep both fragment destinations and the unpublished-inbox disclosure.
import ResponsiveArtwork from "@/components/art/ResponsiveArtwork.vue";
import { ArrowRight, ArrowUpRight, Handshake } from "@lucide/vue";
import { environmentArtwork, storybookPostcards } from "@/data/artwork";
import { nariLinks } from "@/data/socials";

const fits = [
  {
    title: "Creator collaborations",
    text: "Thoughtful streams, videos, and community projects with clear expectations.",
  },
  {
    title: "Creative opportunities",
    text: "Projects with room for personality, color, and Nari's self-taught nail-art perspective.",
  },
  {
    title: "Brand partnerships",
    text: "Respectful ideas, transparent deliverables, and a genuine fit with her people.",
  },
];
---

<SiteLayout pageId="workWithNari">
  <!-- The letter and profile directory are separately addressable; preserve painted margin clearance around the text. -->
  <RoomArrival room="work" artwork={environmentArtwork.work} description="Nari at her autumn correspondence desk while a Ghostie carries a letter." note="FROM THE WRITING DESK">

      <p class="eyebrow">
        <Handshake size={16} aria-hidden="true" /> a note from the writing desk
      </p>
      <h1>
        Let's make
        <br />
        <em>something lovely.</em>
      </h1>
      <p>Bring a clear idea, honest terms, and enough room for Nari to still sound like Nari.</p>
      <a class="button button--ember" href="#collaboration-note">
        Read the collaboration note <ArrowRight size={17} aria-hidden="true" />
      </a>

  </RoomArrival>
  <!-- This fragment is linked from the hero; keep the correspondence margin outside the letter text. -->
  <section id="collaboration-note" class="correspondence room-section page-width" aria-labelledby="letter-title">
    <div class="correspondence__margin">
      <p class="room-kicker">From the writing desk</p>
      <ResponsiveArtwork
        artwork={storybookPostcards.work}
        fallbackWidth={480}
        sizes="(min-width: 64rem) 336px, (min-width: 40rem) 224px, 112px"
        alt="Nari writing a letter at her warm autumn desk, with a little Ghostie beside her"
      />
      <p>
        Clear expectations.
        <br />
        Room for personality.
      </p>
      <RoomCompanion pose="shy" />
      <span class="correspondence__signature" aria-hidden="true">
        Nari Nuna
      </span>
    </div>
    <div class="collaboration-letter" data-material-reveal>
      <div class="collaboration-letter__masthead">
        <span>Work with Nari</span>
        <span>A good first conversation</span>
      </div>
      <h2 id="letter-title">
        An idea worth
        <br />
        <em>pulling up a chair for.</em>
      </h2>
      <p class="collaboration-letter__intro">Here is what may fit—and what a useful first message needs to include.</p>
      <dl class="collaboration-letter__fits">
        {fits.map((fit, index) => (
          <div>
            <dt>
              <span aria-hidden="true">0{index + 1}</span>
              {fit.title}
            </dt>
            <dd>{fit.text}</dd>
          </div>
        ))}
      </dl>
      <div class="collaboration-letter__brief">
        <h3>Tell her what you have in mind.</h3>
        <ol>
          <li>
            <strong>The idea.</strong> Project, audience, platform, timing, and who's involved.
          </li>
          <li>
            <strong>The details.</strong> Deliverables, approvals, usage rights, deadlines, and compensation.
          </li>
          <li>
            <strong>The fit.</strong> Why Nari, and what makes it right for her community.
          </li>
        </ol>
      </div>
      <p class="collaboration-letter__contact">
        A dedicated business inbox hasn't been published yet. You can find Nari through her public profiles below.
      </p>
      <a class="letter-link" href="#nari-links">
        Find Nari's public profiles <ArrowRight size={18} aria-hidden="true" />
      </a>
    </div>
  </section>
  <!-- Public profiles are the current contact route; do not invent an inbox or form. -->
  <section id="nari-links" class="public-directory room-section page-width" aria-labelledby="nari-links-title">
    <header class="room-heading">
      <div>
        <p class="room-kicker">Elsewhere in the Haven</p>
        <h2 id="nari-links-title">Find your way to Nari.</h2>
      </div>
      <p>Streams, creative work, and everyday updates.</p>
    </header>
    <nav class="public-directory__links" aria-label="Nari's public links">
      {nariLinks.map((link, index) => (
        <a href={link.url} target="_blank" rel="noreferrer noopener">
          <span class="public-directory__number" aria-hidden="true">
            0{index + 1}
          </span>
          <span>
            <strong>{link.label}</strong>
            <small>{link.handle}</small>
            <span class="public-directory__purpose">{link.purpose}</span>
          </span>
          <ArrowUpRight size={18} aria-hidden="true" />
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      ))}
    </nav>
  </section>
</SiteLayout>
<style lang="scss">
  @use "../../styles/rooms/work.scss";
</style>
