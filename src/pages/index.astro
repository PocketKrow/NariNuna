---
import SiteLayout from "@/layouts/SiteLayout.astro";
import SceneFigure from "@/components/art/SceneFigure.astro";
import CreatorArt from "@/components/art/CreatorArt.astro";
import PlatformIcon from "@/components/ui/PlatformIcon.astro";
import { twitchUrl } from "@/data/socials";
import { ArrowRight, ArrowUpRight } from "@lucide/vue";
// Home introduces Nari, then offers exactly three illustrated onward paths.
const destinations = [
  { href: "/streams/", title: "Streams", note: "Games, glorious panic, and a good long yap.", art: "connections-game" },
  { href: "/nail-studio/", title: "Creativity", note: "Tiny canvases. An unreasonable amount of polish.", art: "creativity-desk" },
  { href: "/haven/", title: "Haven", note: "Loud laughs, quiet corners. Room for you.", art: "haven-door" },
] as const;
---
<SiteLayout pageId="home">
  <section class="home-intro page-width" aria-labelledby="home-title">
    <div class="home-copy">
      <p class="eyebrow handwritten">Hi. Come inside.</p>
      <h1 id="home-title">Nari <em>Nuna.</em></h1>
      <p class="intro-line">Your favorite chaotic big sister.</p>
      <p class="home-description">A cozy stream, a little nail polish, and somebody always yapping. Pull up a seat.</p>
      <div class="hero-actions">
        <a class="button" href={twitchUrl} target="_blank" rel="noopener noreferrer"><PlatformIcon platform="twitch" /> Watch on Twitch <ArrowUpRight size={17} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a>
        <a class="text-link" href="/meet-nari/">Meet Nari <ArrowRight size={16} aria-hidden="true" /></a>
      </div>
    </div>
    <SceneFigure scene="home" class="home-scene" eager priority />
  </section>
  <nav class="destination-strip page-width" aria-label="A little more of Nari">
    {destinations.map(({ href, title, note, art }) => <a class="destination" href={href}>
      <CreatorArt asset={art} alt="" sizes="(min-width: 48rem) 280px, 36vw" maxWidth={320} />
      <span><strong>{title}<ArrowRight size={16} aria-hidden="true" /></strong><small>{note}</small></span>
    </a>)}
  </nav>
</SiteLayout>
