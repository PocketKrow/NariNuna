---
import SiteLayout from '@/layouts/SiteLayout.astro';
import RoomObject from '@/components/astro/RoomObject.astro';
import ArtworkCreditLink from '@/components/art/ArtworkCreditLink.vue';
import SocialDock from '@/components/ui/SocialDock.vue';
import { havenArtwork, roomObjects } from '@/data/havenArtwork';
import { heroStyle } from '@/data/artworkDelivery';
import '@/styles/rooms/home.scss';
---
<SiteLayout pageId="home">
  <div class="home-room__welcome page-width">
    <div>
      <p class="room-kicker">Come in, Ghostie.</p>
      <h1 id="home-title">Nari's <em>Haven.</em></h1>
    </div>
    <p>Your favorite chaotic big sister.<br />Pick a little corner. Make yourself at home.</p>
  </div>
  <section class="home-room responsive-hero" style={heroStyle(havenArtwork.home)} data-experience aria-labelledby="home-title">
    <div class="home-room__painting room-arrival__painting" role="img" aria-label="A warm wooden room at dusk, with a lavender armchair, bookshelves and a view into the garden.">
      <canvas class="ambient-field" data-atmosphere aria-hidden="true"></canvas>
    </div>
    <nav class="home-room__objects" aria-label="Explore Nari's room">
      {roomObjects.map((object) => <RoomObject object={object} />)}
    </nav>
    <button class="atmosphere-control" type="button" data-atmosphere-control hidden aria-pressed="false">Pause atmosphere</button>
  </section>
  <div class="home-room__aftercare page-width">
    <p>A warm seat for lovely weirdos.</p>
    <SocialDock />
    <ArtworkCreditLink creditId="website-storybook-artwork" label="Artwork & the people behind it" />
  </div>
</SiteLayout>
<script>
  import { startExperience } from '@/experiences/core/lifecycle';
  startExperience();
</script>
