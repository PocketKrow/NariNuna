---
import SiteLayout from "@/layouts/SiteLayout.astro";
import RoomArrival from "@/components/astro/RoomArrival.astro";
import ResponsiveArtwork from "@/components/art/ResponsiveArtwork.vue";
import ArtworkCreditLink from "@/components/art/ArtworkCreditLink.vue";
import { ArrowRight } from "@lucide/vue";
import SocialDock from "@/components/ui/SocialDock.vue";
import { environmentArtwork, storybookPostcards } from "@/data/artwork";
const corners = [
  { href: "/streams/", name: "Streams", label: "At the broadcast desk", note: "There's always one more good bit.", artwork: storybookPostcards.streams },
  { href: "/nail-studio/", name: "Nail Studio", label: "At the workbench", note: "A little glitter gets everywhere.", artwork: storybookPostcards.nails },
  { href: "/haven/", name: "The Haven", label: "In the common room", note: "Leave the room a little kinder.", artwork: storybookPostcards.haven },
];
---
<SiteLayout pageId="home">
  <RoomArrival room="home" artwork={environmentArtwork.homeSunset} description="Nari, with emerald eyes, asymmetric cat-and-dog ears, lavender clothes, and her purple-tipped tail, offers a seat beside a Ghostie at the autumn window in her Haven." atmosphere>
    <p class="eyebrow">A warm seat for lovely weirdos</p>
    <h1><span>Nari</span><em>Nuna</em></h1>
    <p class="arrival-subtitle">Your favorite chaotic big sister.</p>
    <p>Streams get loud, polish gets everywhere, and somebody is always yapping. Pull up a seat.</p>
    <div class="arrival-actions">
      <a class="button button--ember" href="/haven/">Explore the Haven <ArrowRight size={17} aria-hidden="true" /></a>
      <a class="text-link" href="/meet-nari/">Meet Nari <ArrowRight size={15} aria-hidden="true" /></a>
    </div>
    <SocialDock />
    <ArtworkCreditLink creditId="website-storybook-artwork" />
  </RoomArrival>
  <section class="haven-corners room-section page-width" aria-labelledby="corners-title">
    <header class="room-heading">
      <div><p class="room-kicker">Make yourself at home</p><h2 id="corners-title">A few favorite <em>corners.</em></h2></div>
    </header>
    <div class="haven-corners__shelf">
      {corners.map((corner) => (
        <a class="haven-corner" href={corner.href} data-material-reveal>
          <div class="haven-corner__frame"><ResponsiveArtwork artwork={corner.artwork} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 44vw, calc(100vw - 48px)" alt="" /></div>
          <div class="haven-corner__caption">
            <p class="haven-corner__label">{corner.label}</p>
            <h3>{corner.name} <ArrowRight size={18} aria-hidden="true" /></h3>
            <p class="haven-corner__note">{corner.note}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
  <section class="welcome-room page-width" aria-labelledby="welcome-room-title">
    <div class="welcome-room__image">
      <img src="/media/storybook/welcome/welcome-room-1200.webp" srcset="/media/storybook/welcome/welcome-room-720.webp 720w, /media/storybook/welcome/welcome-room-1200.webp 1200w" sizes="(min-width: 64rem) 52vw, calc(100vw - 32px)" width="1200" height="600" loading="lazy" decoding="async" alt="A Ghostie waits beside two cups of tea in a warmly lit autumn room." />
    </div>
    <div class="welcome-room__note">
      <p class="room-kicker">There's room for you here</p>
      <h2 id="welcome-room-title">Come as you <em>are.</em></h2>
      <p>Whether you're here for a laugh, a little company, or a quiet place to land, there's a spot for you in the Haven.</p>
      <a class="text-link" href="/haven/">Get to know the Haven <ArrowRight size={16} aria-hidden="true" /></a>
      <ArtworkCreditLink creditId="website-storybook-artwork" />
    </div>
  </section>
</SiteLayout>
<style lang="scss">
  @use "../styles/rooms/home.scss";
</style>
