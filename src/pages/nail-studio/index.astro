---
import SiteLayout from "@/layouts/SiteLayout.astro";
import SceneFigure from "@/components/art/SceneFigure.astro";
import { nariLinks } from "@/data/socials";
import { ArrowUpRight } from "@lucide/vue";
const youtube = nariLinks.find(({ platform }) => platform === "youtube")!;
---
<SiteLayout pageId="nailStudio">
  <section class="nails-opening page-width" aria-labelledby="creativity-title">
    <div><p class="eyebrow handwritten">At Nari's creative desk</p><h1 id="creativity-title">Nail art.<br /><em>One tiny detail at a time.</em></h1>
      <p class="intro-line">Practice, polish, and a little trouble.</p>
      <p>Self-taught and still experimenting. Color, tiny canvases, and a frankly unreasonable affection for nail polish.</p>
      <a class="text-link" href={youtube.url} target="_blank" rel="noopener noreferrer">Explore Nari's videos <ArrowUpRight size={16} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a>
    </div><SceneFigure scene="nailStudio" eager priority />
  </section>
  <section id="nail-desk" class="studio-notes page-width" aria-labelledby="practice-title">
    <div><p class="eyebrow">The real-work collection</p><h2 id="practice-title">A little work <em>in progress.</em></h2><p>Nari's own approved photographs will go here. Until then, the desk illustration is a little atmosphere, and the gallery is waiting for the real thing.</p><p class="small-note">Personal practice and self-taught nail art. No salon services or bookings.</p></div>
    <div id="resources"><p class="eyebrow">The quieter shelf</p><h2>Things I <em>actually use.</em></h2><p>Nari's tools and resources are still being curated. Her own picks will belong here once she's ready to share them.</p></div>
  </section>
</SiteLayout>
