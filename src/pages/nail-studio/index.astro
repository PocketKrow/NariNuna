---
import RoomCompanion from "@/components/astro/RoomCompanion.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import RoomArrival from "@/components/astro/RoomArrival.astro";

// Present self-taught practice and the illustrated desk honestly. Keep the real-photo hold and exact resource-shelf destination.
import ResponsiveArtwork from "@/components/art/ResponsiveArtwork.vue";
import ArtworkCreditLink from "@/components/art/ArtworkCreditLink.vue";
import RoomDiscovery from "@/components/ui/RoomDiscovery.vue";
import { ArrowRight, Heart, Paintbrush, Sparkles } from "@lucide/vue";
import GhostieArt from "@/components/art/GhostieArt.vue";
import { environmentArtwork, storybookPostcards } from "@/data/artwork";
---

<SiteLayout pageId="nailStudio">
  <!-- Illustrated atmosphere leads into practice notes and an honest real-work hold; artwork is not portfolio evidence. -->
  <RoomArrival room="nails" artwork={environmentArtwork.nails} description="An illustrated view of Nari's autumn nail-art desk. This is atmosphere, not a nail portfolio." note="POLISH, PRACTICE & PATIENCE">

        <p class="eyebrow">
          <Paintbrush size={16} aria-hidden="true" /> her favorite little desk
        </p>
        <h1>
          Tiny canvases.
          <br />
          <em>Big Nari energy.</em>
        </h1>
        <p>Nari is self-taught, still practicing, and learning one tiny detail at a time.</p>
        <div class="tag-row">
          <span>
            <Heart size={15} aria-hidden="true" /> Made with love
          </span>
          <span>
            <Sparkles size={15} aria-hidden="true" /> Probably with glitter
          </span>
        </div>
        <ArtworkCreditLink creditId="website-storybook-artwork" />

  </RoomArrival>
  <section class="studio-workbench room-section page-width" aria-labelledby="workbench-title">
    <header class="room-heading">
      <div>
        <p class="room-kicker">Polish · practice · a little patience</p>
        <h2 id="workbench-title">
          One set.
          <br />
          <em>Then the next.</em>
        </h2>
      </div>
      <p>Color, tiny details, glitter experiments, and honest practice on her own nails.</p>
    </header>
    <div class="studio-workbench__spread">
      <figure class="studio-workbench__scene" data-material-reveal>
        <ResponsiveArtwork
          artwork={storybookPostcards.nails}
          sizes="(min-width: 80rem) 760px, (min-width: 48rem) 58vw, calc(100vw - 32px)"
          alt="An illustrated view of Nari's nail workspace"
        />
        <figcaption>
          Inside the nail desk <span>Workspace illustration</span>
        </figcaption>
        <ArtworkCreditLink creditId="website-storybook-artwork" label="About this illustration" />
      </figure>
      <div class="studio-workbench__notes">
        <RoomCompanion pose="nailTech" placement="bookmark" />
        <article>
          <p class="room-kicker">01 · The practice</p>
          <h3>A little better, one set at a time.</h3>
          <p>Nari is a self-taught artist exploring color, process, and details on her own nails.</p>
        </article>
        <article>
          <p class="room-kicker">02 · The learning</p>
          <h3>Figuring it out is part of the fun.</h3>
          <p>Honest little lessons, creative experiments, and the things she learns along the way.</p>
          <a class="text-link" href="/resources/#nail-desk">
            Visit the nail desk shelf <ArrowRight size={16} aria-hidden="true" />
          </a>
        </article>
      </div>
    </div>
    <RoomDiscovery discoveryId="workbench-bookmark" />
    <!-- This hold remains until real, approved photographs replace the illustrative workspace. -->
    <div class="studio-portfolio-hold">
      <GhostieArt variant="study" sizes="128px" />
      <div>
        <p class="room-kicker">The real-work collection</p>
        <h2>The gallery is waiting for the real thing.</h2>
        <p>
          Nari's own approved photographs will go here. Until then, the illustrated desk stays clearly labelled as
          atmosphere.
        </p>
      </div>
    </div>
    <p class="studio-scope">
      Self-taught nail art and personal practice. No salon services or bookings; educational content is not medical
      advice.
    </p>
  </section>
</SiteLayout>
<style lang="scss">
  @use "../../styles/rooms/nails.scss";
</style>
