---
import SiteLayout from "@/layouts/SiteLayout.astro";
import SceneFigure from "@/components/art/SceneFigure.astro";
import ResponsiveArtwork from "@/components/art/ResponsiveArtwork.vue";
import { approvedArchiveArtwork, publicCreditGroups } from "@/data/artCredits";
import type { CreditStatus } from "@/types/content";
const labels: Record<CreditStatus, string> = { verified: "Verified", pending: "Awaiting confirmation", internal: "Project-created", "not-required": "Credit not required", blocked: "Do not publish" };
---
<SiteLayout pageId="credits">
  <section class="credits-opening illustrated-opening page-width"><div><p class="eyebrow">The names behind the work</p><h1>The people behind<br /><em>the pretty things.</em></h1><p>Art matters. So does knowing who made it. Confirmed credits belong here; anything unresolved stays clearly marked until it can be named properly.</p></div><SceneFigure scene="credits" class="credits-scene" eager /></section>
  <div class="credit-ledger page-width">{publicCreditGroups.map((group) => <section class="credit-group" aria-labelledby={`group-${group.id}`}><div><h2 id={`group-${group.id}`}>{group.label}</h2><p class="small-note">{group.description}</p></div><div>{group.credits.map((credit) => <article class="credit-entry" id={credit.id} tabindex="-1"><p class="credit-entry__status">{labels[credit.creditStatus]}</p><h3>{credit.displayName}</h3><p class="credit-entry__roles">{credit.roles.join(" · ")}</p><p>{credit.contribution}</p><p class="small-note">{credit.creditText}</p>{credit.links.map(({ url, label }) => <a href={url} target="_blank" rel="noopener noreferrer">{label}<span class="sr-only"> (opens in a new tab)</span></a>)}</article>)}</div></section>)}</div>
  {approvedArchiveArtwork.length > 0 && <section class="page-width" aria-label="Approved artwork archive">{approvedArchiveArtwork.map((artwork) => <figure id={artwork.id}><ResponsiveArtwork artwork={artwork.src} alt={artwork.alt} sizes="(min-width: 48rem) 480px, 90vw" /><figcaption>{artwork.title} · {artwork.caption} <a href={`#${artwork.credit.id}`}>{artwork.credit.displayName}</a></figcaption></figure>)}</section>}
  <section class="credit-correction page-width"><h2>A credit needs correcting?</h2><p>Tell Nari through a <a href="/links/">public profile</a>. Private contracts and approval messages stay out of this ledger.</p></section>
</SiteLayout>
