---
import SiteLayout from "@/layouts/SiteLayout.astro";
import SceneFigure from "@/components/art/SceneFigure.astro";
import HavenDoor from "@/components/haven/HavenDoor.astro";
import { communityValues } from "@/data/content";
import { throneUrl } from "@/data/socials";
import { ArrowUpRight } from "@lucide/vue";
---
<SiteLayout pageId="haven">
  <section class="haven-opening page-width" aria-labelledby="haven-title">
    <div><p class="eyebrow handwritten">Nari & the Ghosties</p><h1 id="haven-title">A little <em>Haven.</em></h1><p class="intro-line">Loud laughs. Quiet corners. Room for you.</p><p>Bring your whole weird self. Good company starts with care for each other—and enough space to be yourself.</p><p class="haven-motto">Kindness has a backbone.</p></div>
    <SceneFigure scene="haven" eager priority />
  </section>
  <section class="haven-threshold page-width" aria-labelledby="values-title">
    <div id="values"><p class="eyebrow">The way we keep it warm</p><h2 id="values-title">Good company.<br /><em>Good boundaries.</em></h2>
      <ol class="values-list">{communityValues.map(({ title, description }) => <li><h3>{title}</h3><p>{description}</p></li>)}</ol>
    </div>
    <div class="door-space" id="community"><p class="eyebrow">The door is right here</p><HavenDoor /></div>
  </section>
  <section id="support" class="support-note page-width" aria-labelledby="support-title">
    <div><p class="eyebrow">Always optional</p><h2 id="support-title">Just being here <em>counts.</em></h2><p>Watch, share a good moment, or bring a little kindness to chat. Your presence matters. Financial support is optional.</p></div>
    <div><a class="text-link" href={throneUrl} target="_blank" rel="noopener noreferrer">Nari's Throne wishlist <ArrowUpRight size={16} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a><p class="small-note">Financial support never buys access, ownership, or a claim on Nari's time.</p></div>
  </section>
</SiteLayout>
