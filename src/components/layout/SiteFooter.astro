---
import CreatorArt from "@/components/art/CreatorArt.astro";
import SocialDock from "@/components/ui/SocialDock.vue";
import { footerNavigation } from "@/data/navigation";
interface Props { currentPath: string }
const isStreams = Astro.props.currentPath === "/streams/";
// Preserve old /links/#community and #support bookmarks after its 301 to Streams.
---
<footer class="site-footer page-width">
  <div class="footer-welcome"><a class="brand" href="/" aria-label="Nari Nuna home"><CreatorArt asset="haven-mark" class="brand-mark" sizes="36px" /><span class="brand-name">Nari Nuna</span></a><p class="handwritten">A little warmth. A little chaos.</p></div>
  <div class="footer-profiles" id="profiles"><SocialDock compact ariaLabel="Nari Nuna’s public profiles" /><small>Throne support is always optional.</small></div>
  <div class="footer-note" id={isStreams ? "community" : undefined}><p>Kindness has a backbone.</p><a class="text-link" href="/haven/">Make yourself at home</a><span id={isStreams ? "support" : undefined}><a href="/haven/#support">Support, without pressure</a></span></div>
  <div class="footer-bottom"><p>Made for Nari Nuna & the Ghosties.</p><nav aria-label="Footer">{footerNavigation.map(({ label, href }) => <a href={href}>{label}</a>)}</nav></div>
</footer>
