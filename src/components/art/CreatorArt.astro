---
import manifest from "@/data/anime-artwork.json";
type Asset = keyof typeof manifest.artworks;
interface Props { asset: Asset; class?: string; sizes?: string; maxWidth?: number; alt?: string; eager?: boolean; priority?: boolean }
const { asset: id, class: className, sizes = "240px", maxWidth = Infinity, alt, eager = false, priority = false } = Astro.props;
const art = manifest.artworks[id];
const candidates = art.candidates.filter(({ width }) => width <= maxWidth);
if (!candidates.length) throw new Error(`No artwork candidate fits ${id} at ${maxWidth}px`);
const fallback = candidates.find(({ width }) => width >= 320) ?? candidates.at(-1)!;
---
<img class={className} src={fallback.src} srcset={candidates.map(({ src, width }) => `${src} ${width}w`).join(", ")} sizes={sizes} width={art.width} height={art.height} alt={alt ?? art.alt} loading={eager ? "eager" : "lazy"} fetchpriority={priority ? "high" : "auto"} decoding="async" data-creator-art={id} />
