---
import CreatorArt from "@/components/art/CreatorArt.astro";
interface Props { portrait?: boolean; eager?: boolean; class?: string }
const { portrait = false, eager = true, class: className } = Astro.props;
const sizes = portrait ? "(min-width: 48rem) 430px, 250px" : "(min-width: 48rem) 240px, 180px";
---
<div class="nari-illustration" data-nari-model><CreatorArt asset={portrait ? "welcome-portrait" : "welcome"} class={className} sizes={sizes} eager={eager} priority={eager} /></div>
