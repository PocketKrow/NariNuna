---
// One composition owner replaces the historical hero cascade. Artwork keys and preloads stay in the delivery pipeline.
import { heroStyle } from "@/data/artworkDelivery";
import { havenRooms } from "@/data/rooms";
import "@/styles/objects/arrival.scss";
interface Props {
  room: string;
  artwork: string;
  description: string;
}
const { room, artwork, description } = Astro.props;
const roomPaths: Record<string, string> = { meet: "/meet-nari/", streams: "/streams/", nails: "/nail-studio/", haven: "/haven/", resources: "/resources/", work: "/work-with-nari/", stories: "/stories/", support: "/support/" };
const roomLabel = havenRooms.find(({ href }) => href === roomPaths[room])?.label;
---
<section class={`room-arrival room-arrival--${room} responsive-hero`} style={heroStyle(artwork)} data-experience>
  <div class="room-arrival__painting" role="img" aria-label={description}>
    <div class="room-arrival__light" aria-hidden="true"></div>
  </div>
  <div class="room-arrival__body page-width">
    <div class="room-arrival__copy">
      {roomLabel && <nav class="arrival-location" aria-label="Breadcrumb"><a href="/">Nari's Haven</a><span aria-hidden="true">/</span><span aria-current="page">{roomLabel}</span></nav>}
      <slot />
    </div>
  </div>
</section>
<script>
  import { startExperience } from "@/experiences/core/lifecycle";
  startExperience();
</script>
