---
// An environmental resident is decorative, fully framed and lazy. It never covers interactive content.
import { communityGhostieArtwork } from "@/data/artwork";
import { artworkMetadata, artworkSrc, artworkSrcset } from "@/data/artworkDelivery";
interface Props { pose: keyof typeof communityGhostieArtwork; placement?: "bookmark" | "shelf" | "desk"; }
const { pose, placement = "desk" } = Astro.props;
const artwork = communityGhostieArtwork[pose];
const metadata = artworkMetadata(artwork);
---
<div class={`room-companion room-companion--${placement}`} aria-hidden="true">
  <img src={artworkSrc(artwork, 128)} srcset={artworkSrcset(artwork, 256)} sizes="(min-width: 48rem) 128px, 80px" width={metadata.width} height={metadata.height} alt="" loading="lazy" decoding="async" />
</div>
<style>
  .room-companion { position: relative; width: 8rem; height: 8rem; margin: 0; pointer-events: none; filter: drop-shadow(0 .6rem .6rem #160c1c30); }
  .room-companion img { width: 100%; height: 100%; object-fit: contain; }
  .room-companion--bookmark { margin-left: auto; margin-top: -1.25rem; margin-bottom: -.5rem; }
  .room-companion--shelf { margin-left: auto; margin-bottom: -.6rem; }
  .room-companion--desk { margin-top: .5rem; }
  @media(max-width: 47.99rem) { .room-companion { width: 5rem; height: 5rem; } }
</style>
