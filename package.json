{
  "name": "nari-nuna-haven",
  "version": "0.3.0",
  "private": true,
  "description": "Nari Nuna: a minimal, personal Astro creator website.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/prepare-redirects.mjs && npm run typecheck && npm run validate:credits && astro build && node scripts/secure-build.mjs && node scripts/validate-build.mjs && node scripts/validate-performance.mjs",
    "preview": "astro preview",
    "verify:preview": "node scripts/verify-preview.mjs",
    "verify:release": "npm run build && node scripts/verify-release.mjs",
    "start": "npm run preview",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "astro check && vue-tsc --noEmit",
    "check": "npm run lint && npm run build && npm run test && npm run verify:preview",
    "lint": "eslint . --ignore-pattern dist",
    "artwork:prepare": "python3 scripts/prepare-responsive-artwork.py",
    "audit:assets": "node scripts/audit-assets.mjs",
    "validate:credits": "node scripts/validate-credits.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:experience": "playwright test --project=chromium",
    "verify:browsers": "playwright test --project=chromium --project=firefox",
    "verify:release-browsers": "playwright test",
    "verify:visual-update": "playwright test --project=chromium --grep composition --update-snapshots",
    "artwork:model": "python3 scripts/prepare-model-artwork.py",
    "artwork:identity": "python3 scripts/prepare-creator-identity.py",
    "artwork:anime": "python3 scripts/prepare-anime-artwork.py"
  },
  "dependencies": {
    "@astrojs/vue": "7.0.3",
    "@lucide/vue": "^1.31.0",
    "astro": "7.3.5",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.4.0",
    "playwright": "1.62.1",
    "sass": "^1.92.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.0.7"
  },
  "type": "module",
  "displayName": "Nari Nuna's Haven"
}
